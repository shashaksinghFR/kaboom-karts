{
  "name": "steel-genesis-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json && node scripts/prepare-dist.cjs",
    "start": "node dist/server/src/index.js",
    "test": "node ../node_modules/vitest/vitest.mjs run",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.0",
    "colyseus": "^0.16.5",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": { "@types/cors": "^2.8.17", "@types/express": "^5.0.1", "tsx": "^4.19.2", "typescript": "^5.7.3", "vitest": "^3.0.7" }
}
